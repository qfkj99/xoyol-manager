# Copy this file to .env in the project root before deploying with Docker Compose.
# All persistent data is stored in ./data; Compose fixes DB_PATH inside the container.

# Actual public HTTPS origin, without a trailing slash or path.
APP_ORIGIN=https://game.example.com

# Baota/Nginx on the host connects to this loopback port.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# Keep enabled when the app is reachable only through the trusted reverse proxy.
TRUST_PROXY=true

LOG_LEVEL=info
SESSION_HOURS=12
REMEMBER_DAYS=7

# Exact private proxy hostnames/IPs, comma-separated; leave empty if unused.
PROXY_PRIVATE_HOST_ALLOWLIST=

# NODE_ENV=production, COOKIE_SECURE=true and DB_PATH=/app/data/outlook.db are
# fixed by Compose. Access the site through HTTPS; the host does not need Node.js.
