# 本文件用于本机 / 原生 Node.js 运行；Docker 部署请使用 .env.docker.example。
# Docker 固定将项目根目录 ./data 挂载为容器 /app/data。

# 服务端口
PORT=3000

# 日志级别
LOG_LEVEL=info

# 数据库路径（相对于 server/）
DB_PATH=./data/outlook.db

# 登录会话有效期
SESSION_HOURS=12
REMEMBER_DAYS=7

# 本地 HTTP 开发为 false；生产 HTTPS 必须设为 true
COOKIE_SECURE=false

# 反向代理部署时填写浏览器访问的完整源（不带路径）
# APP_ORIGIN=https://mail.example.com
APP_ORIGIN=

# 仅在后端只能通过可信反向代理访问时开启；代理应覆盖转发头
TRUST_PROXY=false

# 允许连接的可信内网代理主机/IP，精确匹配，逗号分隔
PROXY_PRIVATE_HOST_ALLOWLIST=
